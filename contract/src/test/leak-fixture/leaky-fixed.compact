//
// Fixture #2 of 2 for the mandatory disclose() test — see leaky.compact.
// Identical to leaky.compact except for the added disclose() call. Must
// compile successfully; used by
// src/test/verify-leak-fails-to-compile.mjs as a control to prove that
// disclose() is exactly what makes the difference.

pragma language_version 0.23;

import CompactStandardLibrary;

witness rawDataHash(ref: Bytes<32>): Bytes<32>;

export circuit leakRawAttestationData(ref: Bytes<32>): Bytes<32> {
  return disclose(rawDataHash(ref));
}
